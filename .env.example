PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB Connection String (Atlas Replica Set or Local Replica Set)
MONGODB_URI=mongodb://127.0.0.1:27017/swastik_kitty

# Security & Sessions
JWT_SECRET=swastik_kitty_vault_secret_key_2026_super_secure_32_bytes_min
JWT_EXPIRES_IN=30d

# GoKwik Payment Gateway (Sandbox)
GOKWIK_APP_ID=gokwik_test_app_id
GOKWIK_APP_SECRET=gokwik_test_app_secret
GOKWIK_WEBHOOK_SECRET=gokwik_test_webhook_secret
GOKWIK_BASE_URL=https://sandbox.gokwik.co

# Cloudinary Asset Storage
CLOUDINARY_CLOUD_NAME=swastik_jewel
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMS / WhatsApp Notification Provider
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_dlt_approved_template_id
MSG91_SENDER_ID=SWASTK

# Store Configuration
STORE_NAME="Swastik Jewellers"
STORE_PHONE="+919876543210"
STORE_ADDRESS="Main Market, Jewel Palace, India"
